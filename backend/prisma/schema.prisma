// Prisma schema for app-level tables (users, saved games).
// The ML service has its own SQLAlchemy models in the same Postgres DB —
// these are kept disjoint by name and migration history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  games        SavedGame[]

  // PRD §5.6: linked Lichess / Chess.com identity so we can offer
  // a one-click "Play yourself" mode. Nullable until the user opts in.
  linkedChessSource   String? // "lichess" | "chesscom"
  linkedChessUsername String?

  // PLAN.md §6 — account security
  emailVerifiedAt DateTime?
  role            String    @default("user") // "user" | "admin"
  // Incremented to revoke every outstanding JWT ("log out everywhere",
  // forced on password reset / 2FA disable).
  tokenVersion    Int       @default(0)
  // TOTP 2FA: secret stored once setup starts; enabled only after the
  // user proves possession with a valid code.
  totpSecret      String?
  totpEnabledAt   DateTime?
  // Soft-delete: hidden immediately, purged after 14 days (PLAN.md §6.1)
  deletedAt       DateTime?

  emailTokens   EmailToken[]
  recoveryCodes RecoveryCode[]

  @@map("app_users")
}

// Single-use tokens for email verification and password reset. Only the
// SHA-256 hash is stored; the raw token goes in the emailed link.
model EmailToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // "verify" | "reset"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@map("app_email_tokens")
}

// 2FA recovery codes — hashed at rest, single-use.
model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String
  usedAt   DateTime?

  @@index([userId])
  @@map("app_recovery_codes")
}

model SavedGame {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pgn            String
  finalFen       String
  playerColor    String // "w" | "b"
  opponentName   String?
  opponentRating Int?
  opponentSource String? // "lichess" | "chesscom"
  result         String? // "1-0" | "0-1" | "1/2-1/2" | "*"
  numMoves       Int
  timeControl    String? // e.g. "300+0"
  endReason      String? // checkmate / resign / flag / stalemate
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("app_saved_games")
}
