# Database — PRD §3.8: separate DBs for app (Prisma) and ML (SQLAlchemy)
# to avoid migration collisions.
# ML DB (port 5433 in docker-compose to avoid collision with app DB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/mldb
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5433/mldb
# App DB (Prisma — set in backend/.env or here)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

# Redis
REDIS_URL=redis://localhost:6379

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Node.js Backend
BACKEND_PORT=3001
NODE_ENV=development
# REQUIRED — generate with: openssl rand -hex 32 (backend refuses to boot without it)
JWT_SECRET=
# Shared secret between gateway and ML service (openssl rand -hex 24).
# Must match in backend/.env and ml/.env. start-dev.sh generates it.
ML_INTERNAL_KEY=
# Comma-separated origin allowlist; REQUIRED in production
CORS_ORIGINS=

# Docker Postgres credentials (PLAN.md S5) — override the dev defaults
POSTGRES_APP_PASSWORD=
POSTGRES_ML_PASSWORD=

# Stockfish
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_DEPTH=18
STOCKFISH_THREADS=1
STOCKFISH_POOL_SIZE=4

# Lichess API
LICHESS_API_TOKEN=

# Training
DEVICE=cpu
BATCH_SIZE=1024
LEARNING_RATE=0.001
NUM_EPOCHS=20
CHECKPOINT_DIR=data/checkpoints
LOG_DIR=runs

# Frontend
VITE_API_URL=http://localhost:3001/api
