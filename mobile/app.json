{
  "expo": {
    "name": "Move Predictor",
    "slug": "move-predictor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "movepredictor",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0F0F0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.movepredictor.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F0F"
      },
      "package": "com.movepredictor.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ]
  }
}
